BIYING_LICENSE=replace_with_your_biying_api_license

# K-line cache. Production uses /opt/a-share-money-radar/.cache/kline.
KLINE_CACHE_DIR=.cache/kline
KLINE_SYNC_DAILY_DAYS=80
KLINE_SYNC_30M_BARS=160
KLINE_DAILY_MAX_BARS=120
KLINE_30M_MAX_BARS=320
KLINE_SYNC_CONCURRENCY=1
KLINE_SYNC_REPORT_PATH=public/reports/kline-cache.json

# Biying API safety. Requests must be serial. Keep a safety margin below the certificate request limit.
BIYING_MAX_REQUESTS=5500
BIYING_REQUEST_INTERVAL_MS=250

# Derived API cache for money flow and company profiles.
# scan/plan read this cache by default. Set API_CACHE_REFRESH=1 only in the controlled close run.
API_CACHE_DIR=.cache/biying

# Scan tuning.
REPORT_DIR=public/reports
SCAN_REPORT_PATH=public/reports/latest.json
SCAN_HISTORY_DIR=public/reports/history
SCAN_SOURCE=history
SCAN_HISTORY_DAYS=80
SCAN_30M_BARS=160
SCAN_FLOW_DAYS=10
SCAN_FLOW_CANDIDATE_LIMIT=420
SCAN_TOP_N=8
SCAN_MIN_AMOUNT=30000000
SCAN_MAX_PER_SECTOR=2

# Plan tuning.
PLAN_REPORT_PATH=public/reports/plan.json
PLAN_HISTORY_DAYS=80
PLAN_SETUP_WINDOW_DAYS=20
PLAN_30M_BARS=160
PLAN_DAILY_CANDIDATE_LIMIT=260
PLAN_TOP_N=40
PLAN_MIN_AMOUNT=30000000

# Review, health, and stock detail outputs.
REVIEW_REPORT_PATH=public/reports/performance.json
SYSTEM_HEALTH_REPORT_PATH=public/reports/system-health.json
STOCK_DETAILS_DIR=public/reports/stocks

# Email notification. 163.com requires an SMTP authorization code, not the login password.
NOTIFY_SITE_URL=http://112.126.57.131/
NOTIFY_EMAIL_TO=your_receiver@example.com
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_sender@163.com
SMTP_PASS=your_smtp_authorization_code
SMTP_FROM="A股资金雷达 <your_sender@163.com>"
